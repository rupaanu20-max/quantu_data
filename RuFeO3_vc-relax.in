&CONTROL
  calculation = 'vc-relax'
  prefix = 'RuFeO3_2x1x1'
  outdir = '/home/abhunia.chy.iith/new_feruo_p/tmp'
  pseudo_dir = '/home/abhunia.chy.iith/new_feruo_p/pseudo'
  tstress = .true.
  tprnfor = .true.
/

&SYSTEM
  ibrav = 4
  a = 10.65042
  c = 10.00000
  nat = 6
  ntyp = 3
  ecutwfc = 60
  ecutrho = 480

  occupations = 'smearing'
  smearing = 'mp'
  degauss = 0.02

  nspin = 2
  starting_magnetization(1) = 0.3
  starting_magnetization(2) = 0.6
  starting_magnetization(3) = 0.0
/

&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.2
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dynamics = 'bfgs'
/

ATOMIC_SPECIES
Ru 101.07 Ru.pbe-spn-kjpaw_psl.1.0.0.UPF
Fe 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
O  15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS crystal
Ru 0.00000 0.00000 0.25000
Fe 0.00000 0.00000 0.50000
O  0.00000 0.55828 0.75000
Ru 0.50000 0.00000 0.25000
Fe 0.50000 0.00000 0.50000
O  0.50000 0.55828 0.75000

K_POINTS automatic
3 6 4 0 0 0

